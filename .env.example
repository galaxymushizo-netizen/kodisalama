# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Example for a local database:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kodisalama

# ── Authentication (required) ────────────────────────────────────────────────
# The single landlord password used on the login screen (min 8 characters).
APP_PASSWORD=change-me-to-a-strong-password

# Secret used to sign session tokens. Generate one with:
#   openssl rand -hex 32
APP_SESSION_SECRET=generate-a-long-random-hex-string-here

# ── Notes ────────────────────────────────────────────────────────────────────
# - Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# - After setting DATABASE_URL, create the tables with:  npm run db:push
# - Sessions are signed with APP_SESSION_SECRET; rotating it logs everyone out.
